# Cineraagam production settings.
# Generate a filled-in copy with:   node deploy/generate-secrets.mjs cineraagam.example
# NEVER commit deploy/.env — it contains the database password and service key.

# ---- your site ----
# Public address players use (https:// in production).
PUBLIC_URL=https://cineraagam.example
# What Caddy listens for. A domain name gets automatic HTTPS (Let's Encrypt).
# For a local test use  SITE_ADDRESS=:80  with  PUBLIC_URL=http://localhost:8080 and HTTP_PORT=8080
SITE_ADDRESS=cineraagam.example
HTTP_PORT=80
HTTPS_PORT=443

# ---- secrets (generated) ----
POSTGRES_PASSWORD=
JWT_SECRET=
# Public "anon" key (safe in the browser; Row Level Security protects the data)
ANON_KEY=
# Service key — full access. Only for the tools container. Keep it secret.
SERVICE_ROLE_KEY=

# ---- tuning ----
ANON_SIGNUPS_PER_HOUR=30
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
