# Copy to .env.local. For local development run `npm run env:local`, which
# writes these from `supabase status`.

# Public (safe in the browser; Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used by tests and admin scripts.
SUPABASE_SECRET_KEY=
